modules = ["nodejs-24", "python-3.11"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.production]
VITE_PUBLIC_SITE_URL = "https://guardian-os-LedgerGhost90.replit.app"

[userenv.shared]
GUARDIAN_API_BASE = "https://guardian-os-LedgerGhost90.replit.app/api"

[userenv.development]
VITE_PUBLIC_SITE_URL = "https://guardian-os-LedgerGhost90.replit.app"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 23920
externalPort = 3000
