modules = ["nodejs-24", "python-3.11"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.production]
VITE_PUBLIC_SITE_URL = "https://guardian-os-LedgerGhost90.replit.app"

[userenv.shared]
STRIPE_CHECKOUT_SUCCESS_URL = "https://guardian-os-LedgerGhost90.replit.app/guardian/success?session_id={CHECKOUT_SESSION_ID}"
STRIPE_CHECKOUT_CANCEL_URL = "https://guardian-os-LedgerGhost90.replit.app/guardian"
STRIPE_CUSTOMER_PORTAL_RETURN_URL = "https://guardian-os-LedgerGhost90.replit.app/my-subscription"

[userenv.development]
VITE_PUBLIC_SITE_URL = "https://guardian-os-LedgerGhost90.replit.app"
